# Copy to .env and change the secrets before any real deployment.
NODE_ENV=development
PORT=3000
INSTITUTION_NAME=South Asian University

# sqlite (zero setup) or mysql (production)
DB_CLIENT=sqlite
SQLITE_FILE=database/mealsync.db
DB_HOST=localhost
DB_PORT=3306
DB_USER=mealsync
DB_PASSWORD=change-me
DB_NAME=mealsync

JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES_IN=8h
PASS_SECRET=replace-with-a-different-long-random-string

# mock = built-in simulated gateway; razorpay = real gateway (see docs/adr/0004)
PAYMENT_MODE=mock
PAYMENT_SECRET=replace-with-gateway-key-secret
