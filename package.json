{
  "name": "mealsync",
  "version": "1.0.0",
  "description": "MealSync \u2014 digital mess management: subscriptions, verified payments, rotating QR meal passes, meal skips with credit, headcount, complaints and committee polls.",
  "main": "src/server.js",
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning src/server.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch src/server.js",
    "db:init": "node --no-warnings=ExperimentalWarning src/db/init.js",
    "seed": "node --no-warnings=ExperimentalWarning src/db/seed.js",
    "test": "node --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --runInBand --coverage",
    "create-admin": "node --no-warnings=ExperimentalWarning src/db/createAdmin.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "mess",
    "canteen",
    "university",
    "subscription",
    "qr"
  ],
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/db/seed.js",
      "!src/db/init.js",
      "!src/db/createAdmin.js"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "lcov"
    ],
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "qrcode-generator": "^2.0.4",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
